      "additionalProperties": false,
      "description": "Public airport-to-hotel request; physical places come from source data.\n\nAny explicit UTC offset is accepted. The resolving adapter constructs a\nTransferQuery, which converts that instant into the airport's local zone.",
      "properties": {
        "airport": {
          "pattern": "^[A-Z]{3}$",
          "title": "Airport",
          "type": "string"
        },
        "hotel_id": {
          "title": "Hotel Id",
