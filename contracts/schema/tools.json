{
  "$defs": {
    "AspectCount": {
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "enum": [
            "children",
            "noise",
            "cleanliness",
            "food",
            "staff",
            "location",
            "wifi",
            "pets"
          ],
          "title": "Aspect",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "aspect",
        "count"
      ],
      "title": "AspectCount",
      "type": "object"
    },
    "AspectSummary": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "$ref": "#/$defs/ProfileEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "mention_count": {
          "minimum": 0,
          "title": "Mention Count",
          "type": "integer"
        },
        "negative_count": {
          "minimum": 0,
          "title": "Negative Count",
          "type": "integer"
        },
        "positive_count": {
          "minimum": 0,
          "title": "Positive Count",
          "type": "integer"
        },
        "review_count": {
          "minimum": 0,
          "title": "Review Count",
          "type": "integer"
        }
      },
      "required": [
        "positive_count",
        "negative_count",
        "mention_count",
        "review_count",
        "evidence"
      ],
      "title": "AspectSummary",
      "type": "object"
    },
    "DayPrice": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "is_synthetic": {
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "price_rub": {
          "description": "Минимальная цена перелёта за всю группу в одну сторону",
          "minimum": 0,
          "title": "Price Rub",
          "type": "integer"
        }
      },
      "required": [
        "date",
        "price_rub",
        "is_synthetic"
      ],
      "title": "DayPrice",
      "type": "object"
    },
    "Destination": {
      "additionalProperties": false,
      "properties": {
        "air_temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Air Temperature C"
        },
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "As Of"
        },
        "country": {
          "title": "Country",
          "type": "string"
        },
        "estimated_total_price_rub": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Total Price Rub"
        },
        "flight_duration_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Flight Duration Minutes"
        },
        "is_synthetic": {
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "month": {
          "maximum": 12,
          "minimum": 1,
          "title": "Month",
          "type": "integer"
        },
        "place": {
          "$ref": "#/$defs/Place"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ReferenceSource"
          },
          "title": "Sources",
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "visa": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisaEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visa_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Visa Required"
        },
        "water_temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Water Temperature C"
        }
      },
      "required": [
        "place",
        "country",
        "month",
        "air_temperature_c",
        "water_temperature_c",
        "flight_duration_minutes",
        "visa_required",
        "estimated_total_price_rub",
        "is_synthetic"
      ],
      "title": "Destination",
      "type": "object"
    },
    "DestinationQuery": {
      "additionalProperties": false,
      "properties": {
        "budget_rub": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Rub"
        },
        "departure_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Departure Date"
        },
        "min_water_temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Water Temperature C"
        },
        "month": {
          "maximum": 12,
          "minimum": 1,
          "title": "Month",
          "type": "integer"
        },
        "nights": {
          "default": 7,
          "minimum": 1,
          "title": "Nights",
          "type": "integer"
        },
        "origin": {
          "pattern": "^[A-Z]{3}$",
          "title": "Origin",
          "type": "string"
        },
        "travelers": {
          "$ref": "#/$defs/Travelers"
        },
        "visa_free_only": {
          "default": false,
          "title": "Visa Free Only",
          "type": "boolean"
        }
      },
      "required": [
        "month",
        "origin"
      ],
      "title": "DestinationQuery",
      "type": "object"
    },
    "ExtractionMetadata": {
      "additionalProperties": false,
      "properties": {
        "live_model_run": {
          "title": "Live Model Run",
          "type": "boolean"
        },
        "method": {
          "enum": [
            "lexical-fixture-baseline-v1",
            "llm-literal-evidence-v1"
          ],
          "title": "Method",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        }
      },
      "required": [
        "method",
        "model",
        "live_model_run"
      ],
      "title": "ExtractionMetadata",
      "type": "object"
    },
    "Flight": {
      "additionalProperties": false,
      "properties": {
        "arrival_at": {
          "format": "date-time",
          "title": "Arrival At",
          "type": "string"
        },
        "baggage_price_rub": {
          "default": 0,
          "minimum": 0,
          "title": "Baggage Price Rub",
          "type": "integer"
        },
        "carrier": {
          "title": "Carrier",
          "type": "string"
        },
        "demo_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlightDemoSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "departure_at": {
          "format": "date-time",
          "title": "Departure At",
          "type": "string"
        },
        "destination": {
          "$ref": "#/$defs/Place"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "is_overnight": {
          "default": false,
          "title": "Is Overnight",
          "type": "boolean"
        },
        "is_synthetic": {
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/Place"
        },
        "price_rub": {
          "description": "Цена за всю группу в одну сторону",
          "minimum": 0,
          "title": "Price Rub",
          "type": "integer"
        },
        "price_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/FlightPriceSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stops": {
          "default": 0,
          "minimum": 0,
          "title": "Stops",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "origin",
        "destination",
        "departure_at",
        "arrival_at",
        "price_rub",
        "is_synthetic",
        "carrier"
      ],
      "title": "Flight",
      "type": "object"
    },
    "FlightDemoSource": {
      "additionalProperties": false,
      "description": "Explicit offline-demo provenance; never attributes generated prices to a provider.",
      "properties": {
        "kind": {
          "enum": [
            "provider_replay",
            "deterministic_mock"
          ],
          "title": "Kind",
          "type": "string"
        },
        "notice": {
          "minLength": 1,
          "title": "Notice",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "cache_miss",
                "no_matching_quotes"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "kind",
        "notice"
      ],
      "title": "FlightDemoSource",
      "type": "object"
    },
    "FlightPriceSource": {
      "additionalProperties": false,
      "description": "Public quote evidence only; credentials and HTTP request headers are never part of this model.",
      "properties": {
        "baggage_price_is_modelled": {
          "const": true,
          "default": true,
          "title": "Baggage Price Is Modelled",
          "type": "boolean"
        },
        "cache_hit": {
          "title": "Cache Hit",
          "type": "boolean"
        },
        "cache_mode": {
          "enum": [
            "record",
            "replay",
            "live"
          ],
          "title": "Cache Mode",
          "type": "string"
        },
        "currency": {
          "const": "RUB",
          "default": "RUB",
          "title": "Currency",
          "type": "string"
        },
        "duration_is_modelled": {
          "title": "Duration Is Modelled",
          "type": "boolean"
        },
        "group_price_is_modelled": {
          "const": true,
          "default": true,
          "title": "Group Price Is Modelled",
          "type": "boolean"
        },
        "provider": {
          "const": "aviasales_data_api",
          "default": "aviasales_data_api",
          "title": "Provider",
          "type": "string"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recorded At"
        },
        "seat_price_rub": {
          "minimum": 0,
          "title": "Seat Price Rub",
          "type": "integer"
        }
      },
      "required": [
        "seat_price_rub",
        "cache_mode",
        "cache_hit",
        "duration_is_modelled"
      ],
      "title": "FlightPriceSource",
      "type": "object"
    },
    "FlightSearch": {
      "additionalProperties": false,
      "properties": {
        "departure_date": {
          "format": "date",
          "title": "Departure Date",
          "type": "string"
        },
        "destination": {
          "pattern": "^[A-Z]{3}$",
          "title": "Destination",
          "type": "string"
        },
        "direct_only": {
          "default": false,
          "title": "Direct Only",
          "type": "boolean"
        },
        "max_price_rub": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Price Rub"
        },
        "origin": {
          "pattern": "^[A-Z]{3}$",
          "title": "Origin",
          "type": "string"
        },
        "travelers": {
          "$ref": "#/$defs/Travelers"
        }
      },
      "required": [
        "origin",
        "destination",
        "departure_date"
      ],
      "title": "FlightSearch",
      "type": "object"
    },
    "GuestProfile": {
      "additionalProperties": false,
      "properties": {
        "aspects": {
          "additionalProperties": {
            "$ref": "#/$defs/AspectSummary"
          },
          "propertyNames": {
            "enum": [
              "children",
              "noise",
              "cleanliness",
              "food",
              "staff",
              "location",
              "wifi",
              "pets"
            ]
          },
          "title": "Aspects",
          "type": "object"
        },
        "cons": {
          "items": {
            "$ref": "#/$defs/AspectCount"
          },
          "title": "Cons",
          "type": "array"
        },
        "pros": {
          "items": {
            "$ref": "#/$defs/AspectCount"
          },
          "title": "Pros",
          "type": "array"
        },
        "review_count": {
          "minimum": 0,
          "title": "Review Count",
          "type": "integer"
        }
      },
      "required": [
        "review_count",
        "aspects",
        "pros",
        "cons"
      ],
      "title": "GuestProfile",
      "type": "object"
    },
    "HotelOffer": {
      "additionalProperties": false,
      "properties": {
        "adults_only": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adults Only"
        },
        "check_in": {
          "format": "date",
          "title": "Check In",
          "type": "string"
        },
        "check_in_time": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check In Time"
        },
        "check_out": {
          "format": "date",
          "title": "Check Out",
          "type": "string"
        },
        "check_out_time": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Out Time"
        },
        "early_check_in_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Early Check In Available"
        },
        "early_check_in_price_rub": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Early Check In Price Rub"
        },
        "hotel_id": {
          "title": "Hotel Id",
          "type": "string"
        },
        "is_synthetic": {
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "offer_id": {
          "minLength": 1,
          "title": "Offer Id",
          "type": "string"
        },
        "pets_allowed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pets Allowed"
        },
        "place": {
          "$ref": "#/$defs/Place"
        },
        "price_rub": {
          "description": "Полная стоимость за все ночи и всю группу",
          "minimum": 0,
          "title": "Price Rub",
          "type": "integer"
        },
        "rating": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating"
        },
        "reception_24h": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reception 24H"
        },
        "reception_closes_at": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reception Closes At"
        },
        "refundable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refundable"
        },
        "review_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/HotelReviewProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stars": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stars"
        }
      },
      "required": [
        "hotel_id",
        "offer_id",
        "name",
        "place",
        "check_in",
        "check_out",
        "price_rub",
        "is_synthetic"
      ],
      "title": "HotelOffer",
      "type": "object"
    },
    "HotelReviewProfile": {
      "additionalProperties": false,
      "properties": {
        "aspects": {
          "additionalProperties": {
            "$ref": "#/$defs/AspectSummary"
          },
          "propertyNames": {
            "enum": [
              "children",
              "noise",
              "cleanliness",
              "food",
              "staff",
              "location",
              "wifi",
              "pets"
            ]
          },
          "title": "Aspects",
          "type": "object"
        },
        "corpus_generator": {
          "minLength": 1,
          "title": "Corpus Generator",
          "type": "string"
        },
        "corpus_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Corpus Sha256",
          "type": "string"
        },
        "extraction": {
          "$ref": "#/$defs/ExtractionMetadata"
        },
        "guest_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/GuestProfile"
          },
          "propertyNames": {
            "enum": [
              "family",
              "couple",
              "business",
              "pets"
            ]
          },
          "title": "Guest Profiles",
          "type": "object"
        },
        "hotel_id": {
          "title": "Hotel Id",
          "type": "string"
        },
        "is_synthetic": {
          "const": true,
          "title": "Is Synthetic",
          "type": "boolean"
        },
        "notice": {
          "minLength": 1,
          "title": "Notice",
          "type": "string"
        },
        "review_count": {
          "maximum": 50,
          "minimum": 20,
          "title": "Review Count",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "hotel_id",
        "is_synthetic",
        "notice",
        "review_count",
        "corpus_generator",
        "corpus_sha256",
        "extraction",
        "aspects",
        "guest_profiles"
      ],
      "title": "HotelReviewProfile",
      "type": "object"
    },
    "HotelSearch": {
      "additionalProperties": false,
      "properties": {
        "check_in": {
          "format": "date",
          "title": "Check In",
          "type": "string"
        },
        "check_out": {
          "format": "date",
          "title": "Check Out",
          "type": "string"
        },
        "destination": {
          "pattern": "^[A-Z]{3}$",
          "title": "Destination",
          "type": "string"
        },
        "max_price_rub": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Price Rub"
        },
        "min_stars": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Min Stars",
          "type": "integer"
        },
        "refundable_only": {
          "default": false,
          "title": "Refundable Only",
          "type": "boolean"
        },
        "travelers": {
          "$ref": "#/$defs/Travelers"
        }
      },
      "required": [
        "destination",
        "check_in",
        "check_out"
      ],
      "title": "HotelSearch",
      "type": "object"
    },
    "Place": {
      "additionalProperties": false,
      "properties": {
        "iata": {
          "pattern": "^[A-Z]{3}$",
          "title": "Iata",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "kind": {
          "enum": [
            "airport",
            "hotel",
            "city"
          ],
          "title": "Kind",
          "type": "string"
        },
        "latitude": {
          "maximum": 90,
          "minimum": -90,
          "title": "Latitude",
          "type": "number"
        },
        "longitude": {
          "maximum": 180,
          "minimum": -180,
          "title": "Longitude",
          "type": "number"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "timezone": {
          "description": "Часовой пояс IANA, например Europe/Moscow",
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "iata",
        "name",
        "latitude",
        "longitude",
        "timezone"
      ],
      "title": "Place",
      "type": "object"
    },
    "PriceCalendarQuery": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "pattern": "^[A-Z]{3}$",
          "title": "Destination",
          "type": "string"
        },
        "month": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Month",
          "type": "string"
        },
        "origin": {
          "pattern": "^[A-Z]{3}$",
