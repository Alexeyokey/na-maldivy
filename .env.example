# Скопируйте в .env. Для локального демо заполнять ключи не нужно.
# docker compose up --build -> http://localhost:8080
# Без внешней модели: разбор правилами, ответы по шаблонам.
# .env в git не коммитим.

# Порт UI и HTTP API на компьютере. Внутри app всегда 8080.
APP_PORT=8080

# fake — без сети и ключей; openai — любой OpenAI-совместимый API
LLM_PROVIDER=fake
# Пусто — api.openai.com. Для OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
# id моделей из каталога провайдера, выбираем в A3 (#7). Если быстрая не задана, берётся основная.
LLM_MODEL_MAIN=
LLM_MODEL_FAST=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# stub — фиксированные синтетические данные D1 без сети и ключей.
# real — D2/D3/D5/D6/D8/S4 из общего DATA_DIR.
# По умолчанию коммерческие цены/расписания демонстрационные.
TOOLS_MODE=real

# synthetic — без сети; aviasales — котировки Data API через D4, только с TOOLS_MODE=real.
# demo — явно смешанное офлайн-демо: реальные replay-котировки, иначе подписанный deterministic_mock.
# Только TOOLS_MODE=real + CACHE_MODE=replay; ключ не используется и сеть не вызывается.
FLIGHTS_MODE=demo
# Только локально/на сервере. Никогда не передавайте в браузер или аргументы чата.
# Обязателен при CACHE_MODE=record/live; для replay существующих записей не нужен.
AVIASALES_API_TOKEN=
# В Docker по умолчанию /data/demo/aviasales — готовый публичный снимок.
# Для record/live задайте /state/aviasales вместе с FLIGHTS_MODE=aviasales.
# Для record нужна записываемая директория. Публичный demo-снимок не перезаписывайте.
AVIASALES_CACHE_DIR=

# synthetic — без сети; yandex — расписание Яндекса через D4, только с TOOLS_MODE=real.
# Цена, класс и наличие мест остаются модельными/неподтверждёнными в обоих режимах.
TRAINS_MODE=synthetic
# Только локально/на сервере; нужен в record/live, для replay существующих записей не нужен.
YANDEX_RASP_API_KEY=
# Пусто — DATA_DIR/cache/yandex/runtime. Для record нужна записываемая директория.
YANDEX_CACHE_DIR=

# Приватная SQLite-база демо-заказов, отдельно от публичного кэша D4.
# Пусто — .runtime/checkout.sqlite3 рядом с DATA_DIR; в Docker — /state/checkout.sqlite3.
CHECKOUT_DB_PATH=

# Единый корень справочников и кэша. Пусто — data/ в корне репозитория, в Docker — /data.
DATA_DIR=

# replay — только сохранённые публичные ответы; record — сеть и запись; live — сеть без кэша.
# Демо и проверки принудительно выбирают replay.
CACHE_MODE=replay

LOG_LEVEL=INFO
# Откуда фронтенд может ходить в API
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
