# Скопируйте в .env и заполните. Без .env агент работает на фейковой модели, которая повторяет сообщение.
# .env в git не коммитим.

# fake — без сети и ключей; openai — любой OpenAI-совместимый API
LLM_PROVIDER=fake
# Пусто — api.openai.com. Для OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
LLM_API_KEY=
# id моделей из каталога провайдера, выбираем в A3 (#7). Если быстрая не задана, берётся основная.
LLM_MODEL_MAIN=
LLM_MODEL_FAST=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# stub — фиксированные синтетические данные D1 без сети и ключей.
# real — зарезервирован для адаптеров D2/D3/D5/D6/S4; пока create_tools() выдаёт NotImplementedError.
TOOLS_MODE=stub

# D4: replay не обращается в сеть, при отсутствии записи выдаёт CacheMiss.
# record записывает очищенные ответы; live использует сеть без записи.
CACHE_MODE=replay
# Необязательно: отдельная директория кэша вместо data/cache/<provider>.
DATA_CACHE_DIR=
DATA_SEED=42
# Только для явного provider-режима D2/D6; демо работает без ключей.
TRAVELPAYOUTS_TOKEN=
YANDEX_RASP_API_KEY=

LOG_LEVEL=INFO
# Откуда фронтенд может ходить в API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
